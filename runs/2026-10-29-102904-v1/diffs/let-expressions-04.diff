+        except KeyError:
+            raise exceptions.UndefinedVariableError(name)
+
+    def visit_let(self, node, value):
+        children = node['children']
+        new_scope = dict(self._scope)
+        for name, expr in zip(node['value'], children[:-1]):
+            new_scope[name] = self.visit(expr, value)
+        saved = self._scope
+        self._scope = new_scope
+        try:
+            return self.visit(children[-1], value)

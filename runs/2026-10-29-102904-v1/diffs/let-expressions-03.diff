+++ b/jmespath/ast.py
@@ -86,5 +86,16 @@
     return {"type": "slice", "children": [start, end, step]}
 
 
+def variable_ref(name):
+    return {'type': 'variable_ref', 'children': [], 'value': name}
+
+
+def let_expression(bindings, body):
+    # children: one node per binding expression, followed by the body.
+    names = [name for name, _ in bindings]
+    children = [expr for _, expr in bindings] + [body]
+    return {'type': 'let_expression', 'children': children, 'value': names}
+
+
 def value_projection(left, right):
     return {'type': 'value_projection', 'children': [left, right]}

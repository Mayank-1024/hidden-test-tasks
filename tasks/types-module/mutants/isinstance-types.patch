diff --git a/jmespath/types.py b/jmespath/types.py
new file mode 100644
index 0000000..d3964bb
--- /dev/null
+++ b/jmespath/types.py
@@ -0,0 +1,79 @@
+"""The JMESPath type model in one place.
+
+JMESPath has seven types: string, number, boolean, array, object, null and
+expref. The function type checker maps a Python value to one of them by the
+*name* of its Python type, not by isinstance(), so that bool is never treated
+as a number. Values whose type name is not listed map to "unknown".
+
+This module has no imports from the rest of the package, so any module can
+import it without creating an import cycle.
+"""
+from numbers import Number
+
+# python type names -> jmespath types
+TYPES_MAP = {
+    'bool': 'boolean',
+    'list': 'array',
+    'dict': 'object',
+    'NoneType': 'null',
+    'unicode': 'string',
+    'str': 'string',
+    'float': 'number',
+    'int': 'number',
+    'long': 'number',
+    'OrderedDict': 'object',
+    '_Projection': 'array',
+    '_Expression': 'expref',
+}
+
+
+# jmespath types -> python type names
+REVERSE_TYPES_MAP = {
+    'boolean': ('bool',),
+    'array': ('list', '_Projection'),
+    'object': ('dict', 'OrderedDict',),
+    'null': ('NoneType',),
+    'string': ('unicode', 'str'),
+    'number': ('float', 'int', 'long'),
+    'expref': ('_Expression',),
+}
+
+
+def jmespath_type_from_name(python_type_name):
+    """Return the JMESPath type for a Python type name, or "unknown"."""
+    return TYPES_MAP.get(python_type_name, 'unknown')
+
+
+def jmespath_type(value):
+    """Return the JMESPath type the function type checker gives ``value``."""
+    if isinstance(value, bool):
+        return 'boolean'
+    if isinstance(value, str):
+        return 'string'
+    if isinstance(value, (list, tuple)):
+        return 'array'
+    if isinstance(value, dict):
+        return 'object'
+    if value is None:
+        return 'null'
+    if is_number(value):
+        return 'number'
+    return jmespath_type_from_name(type(value).__name__)
+
+
+def is_number(value):
+    """True for numbers, False for bool (which Python treats as an int)."""
+    # >>> isinstance(True, int)
+    # True
+    if isinstance(value, bool):
+        return False
+    return isinstance(value, Number)
+
+
+def is_comparable(value):
+    """True if ``value`` may appear in an ordering comparison (<, >, ...)."""
+    # The spec doesn't officially support string types yet,
+    # but enough people are relying on this behavior that
+    # it's been added back.  This should eventually become
+    # part of the official spec.
+    return is_number(value) or isinstance(value, str)

+def _is_orderable_pair(x, y):
+    # Ordering is only defined between two numbers or two strings.
+    # Checking each side on its own is not enough: a string and a
+    # number are each comparable, but Python cannot order them and
+    # raises TypeError.
+    if _is_actual_number(x) and _is_actual_number(y):
+        return True
+    return isinstance(x, string_type) and isinstance(y, string_type)

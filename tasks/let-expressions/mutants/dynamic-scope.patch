+    def _consume_variable(self):
+        # A variable reference is '$' immediately followed by an
+        # unquoted identifier, e.g. "$foo".
+        start = self._position
+        next_char = self._next()
+        if next_char is None or next_char not in self.START_IDENTIFIER:
+            raise LexerError(lexer_position=start,
+                             lexer_value='$',
+                             message="Expected an identifier after '$'")
+        buff = next_char
+        while self._next() in self.VALID_IDENTIFIER:
+            buff += self._current
+        return {'type': 'variable', 'value': buff,
+                'start': start, 'end': start + len(buff) + 1}
+
     def _consume_number(self):
         start = self._position

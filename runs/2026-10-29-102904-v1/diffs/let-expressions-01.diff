+def variable_ref(name):
+    return {'type': 'variable_ref', 'children': [], 'value': name}
+
+
+def let_expression(names, exprs, body):
+    # 'value' holds the bound names; children are the binding
+    # expressions followed by the body.
+    return {'type': 'let_expression', 'children': list(exprs) + [body],
+            'value': list(names)}
+
+
 def value_projection(left, right):
     return {'type': 'value_projection', 'children': [left, right]}

+
+    def _token_nud_variable(self, token):
+        return ast.variable_ref(token['value'])
+
+    def _parse_let(self):
+        bindings = []
+        while True:
+            var_token = self._lookahead_token(0)
+            self._match('variable')
+            self._match('assign')
+            expr = self._expression(0)
+            bindings.append((var_token['value'], expr))
+            if self._current_token() == 'comma':
+                self._advance()
+                continue
+            break
+        in_token = self._lookahead_token(0)
+        if not (in_token['type'] == 'unquoted_identifier' and
+                in_token['value'] == 'in'):
+            self._raise_parse_error_maybe_eof("'in'", in_token)
+        self._advance()
+        body = self._expression(0)
+        return ast.let_expression(bindings, body)
 
     def _token_nud_quoted_identifier(self, token):
         field = ast.field(token['value'])

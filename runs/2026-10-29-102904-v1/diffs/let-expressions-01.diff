+
+    def _token_nud_variable(self, token):
+        return ast.variable_ref(token['value'])
+
+    def _parse_let_expression(self):
+        names = []
+        exprs = []
+        while True:
+            var = self._lookahead_token(0)
+            self._match('variable')
+            self._match('assign')
+            names.append(var['value'])
+            exprs.append(self._expression(0))
+            if self._current_token() == 'comma':
+                self._advance()
+                continue
+            tok = self._lookahead_token(0)
+            if (tok['type'] == 'unquoted_identifier' and
+                    tok['value'] == 'in'):
+                self._advance()
+                break
+            self._raise_parse_error_maybe_eof('in', tok)
+        body = self._expression(0)
+        return ast.let_expression(names, exprs, body)
 
     def _token_nud_quoted_identifier(self, token):
         field = ast.field(token['value'])

--- /dev/null
+++ b/jmespath/types.py
@@ -0,0 +1,52 @@
+"""The JMESPath type model.
+
+This module must not import anything from the ``jmespath`` package.
+"""
+from numbers import Number
+
+
+# python types -> jmespath types
+TYPES_MAP = {
+    'bool': 'boolean',
+    'list': 'array',
+    'dict': 'object',
+    'NoneType': 'null',
+    'unicode': 'string',
+    'str': 'string',
+    'float': 'number',
+    'int': 'number',
+    'long': 'number',
+    'OrderedDict': 'object',
+    '_Projection': 'array',
+    '_Expression': 'expref',
+}
+
+
+# jmespath types -> python types
+REVERSE_TYPES_MAP = {
+    'boolean': ('bool',),
+    'array': ('list', '_Projection'),
+    'object': ('dict', 'OrderedDict',),
+    'null': ('NoneType',),
+    'string': ('unicode', 'str'),
+    'number': ('float', 'int', 'long'),
+    'expref': ('_Expression',),
+}
+
+
+def jmespath_type(value):
+    """JMESPath type name used by the function type checker."""
+    return TYPES_MAP.get(type(value).__name__, 'unknown')
+
+
+def is_number(value):
+    # bool is a subclass of int in python, but is not a jmespath number.
+    if isinstance(value, bool):
+        return False
+    return isinstance(value, Number)
+
+
+def is_comparable(value):
+    # Strings are orderable, even though the spec doesn't officially
+    # say so; enough people rely on it.
+    return is_number(value) or isinstance(value, str)

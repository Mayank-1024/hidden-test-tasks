         return ast.literal(token['value'])
 
     def _token_nud_unquoted_identifier(self, token):
+        if token['value'] == 'let' and self._current_token() == 'variable':
+            return self._parse_let()
         return ast.field(token['value'])
+
+    def _token_nud_variable(self, token):
+        return ast.variable_ref(token['value'])
+
+    def _parse_let(self):
+        names = []
+        expressions = []
+        while True:
+            var = self._lookahead_token(0)
+            self._match('variable')
+            self._match('assign')
+            expressions.append(self._expression(0))
+            names.append(var['value'])
+            if self._current_token() == 'comma':
+                self._advance()
+                continue
+            break
+        tok = self._lookahead_token(0)
+        if tok['type'] != 'unquoted_identifier' or tok['value'] != 'in':
+            self._raise_parse_error_maybe_eof("'in'", tok)
+        self._advance()
+        body = self._expression(0)
+        return ast.let_expression(names, expressions, body)
 
     def _token_nud_quoted_identifier(self, token):
         field = ast.field(token['value'])
